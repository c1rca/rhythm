# Copy to .env and fill only the channels you use. Never commit .env.
HOST_PORT=8091
# IANA timezone; defaults to Eastern Time with daylight-saving support.
HOUSEHOLD_TIMEZONE=America/New_York

# Gotify (optional)
GOTIFY_URL=
GOTIFY_TOKEN=

# SMTP / email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
DEFAULT_EMAIL_TO=

# SMS: use Twilio for direct delivery to Google Fi and other mobile numbers.
SMS_PROVIDER=twilio
DEFAULT_SMS_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Public, externally reachable Scheduler URL included in reminders.
PUBLIC_URL=

# Legacy carrier email gateway (not reliable for Google Fi)
SMS_GATEWAY_DOMAIN=vtext.com
