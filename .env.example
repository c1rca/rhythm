# Copy to .env and fill only the channels you use. Never commit .env.
HOST_PORT=8091
HOUSEHOLD_TIMEZONE=UTC

# Gotify (optional)
GOTIFY_URL=
GOTIFY_TOKEN=

# SMTP / email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
DEFAULT_EMAIL_TO=

# SMS via carrier email gateway (optional)
DEFAULT_SMS_TO=
SMS_GATEWAY_DOMAIN=vtext.com
